# Postgres connection string (Neon, Supabase, or any Postgres instance).
# Get this from your Neon project dashboard -> Connection Details.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# The deployed URL of the app (Vercel fills this automatically in production,
# but set it for local dev)
NEXTAUTH_URL="http://localhost:3000"

# Used only by prisma/seed.ts to create the two initial admin accounts.
# Set these, run `npm run db:seed` once, then remove/rotate them.
SEED_ADMIN_1_EMAIL="ahmad@example.com"
SEED_ADMIN_1_PASSWORD="change-me-now"
SEED_ADMIN_2_EMAIL="rehan@example.com"
SEED_ADMIN_2_PASSWORD="change-me-now"
